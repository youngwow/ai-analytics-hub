TAVILY_API=
# api_id / api_hash с https://my.telegram.org → раздел API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# ключ Ollama Cloud (ollama.com → Settings → Keys); без него обработка не запустится
OLLAMA_API_KEY=
# OpenRouter используется для embeddings; секрет хранится только в .env
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-001
