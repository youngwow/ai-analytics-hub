TAVILY_API=
# api_id / api_hash с https://my.telegram.org → раздел API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# ключ Ollama Cloud (ollama.com → Settings → Keys); без него обработка не запустится
OLLAMA_API_KEY=

# ── HTTP-API (`python -m src serve`, docker compose) — читает `Settings` в src/config.py ──
# ENVIRONMENT=local            # local | dev | prod; local включает автоперезапуск в `python -m src.main`
# HOST=127.0.0.1               # в контейнере — 0.0.0.0
# PORT=8000
# DOCS=true                    # отдавать /docs и /openapi.json
# CORS_ORIGINS=["*"]           # JSON-список источников фронтенда
# LOG_LEVEL=INFO
# Корень данных задаётся только переменной окружения HUB_ROOT (строка в .env не читается).
