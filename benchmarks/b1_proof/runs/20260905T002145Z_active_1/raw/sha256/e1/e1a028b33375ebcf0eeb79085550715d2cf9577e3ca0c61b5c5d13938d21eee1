ность. Что привело к попытке переворота, как прошли эти три дня и почему дальнейшая судьба Союза была предрешена – в сюжете «Ведомостей».","taggings":[],"title":"Переломный 1991-й: как СССР прошел точку невозврата","url":"vedomosti.ru\u002Fstory\u002Fperelomnyj1991"},{"archived":false,"background_color":"dark","categories":{"kinds":{"path":"kinds.story_page","slug":"story_page","title":"Страница сюжета","position":90,"subscribable":false},"story":[{"path":"story.toplivo","slug":"toplivo","title":"Ситуация на топливном рынке в России","position":2760,"subscribable":false}],"domains":{"path":"domains.vedomosti_ru","slug":"vedomosti.ru","title":"vedomosti.ru","position":0,"subscribable":false},"project":{"path":"project.vedomosti","slug":"vedomosti","title":"Ведомости","position":10,"subscribable":false}},"clickable":false,"company_title":"","company_url":"","disclaimer":"","editor_id":0,"favorite":false,"h1":null,"hide_in_app":false,"hide_mobile_partner_announcement_logo":false,"hide_mobile_partner_logo":false,"hide_partner_announcement_logo":false,"hide_partner_logo":false,"id":140737489441586,"image":{"_preview":{"url":"\u002Fimage\u002F2026\u002F50\u002Fxypey\u002F_preview-180m.jpg","size":5079,"width":110,"height":73,"filename":"_preview-180m.jpg","url_webp":"\u002Fimage\u002F2026\u002F50\u002Fxypey\u002F_preview-180m.webp","attachment_id":140737489302553,"filename_webp":"_preview-180m.webp"},"original":{"url":"\u002Fimage\u002F2026\u002F50\u002Fxypey\u002Foriginal-180m.jpg","size":312287,"width":1500,"height":1000,"filename":"original-180m.jpg","url_webp":"\u002Fimage\u002F2026\u002F50\u002Fxypey\u002Foriginal-180m.webp","attachment_id":140737489302553,"filename_webp":"original-180m.webp"}},"last_published_at":1782840508,"links":{},"list":{"id":140737488357815,"slug":"story-toplivo-top","seo_title":null,"seo_keywords":null,"seo_description":null},"main_token":"","partner_logo_text":"","partner_url":"","publish_delay_datetime":null,"publish_delay_set":false,"publi